// acmeclient.nv — the half that talks to the certificate authority.
//
// THE ONLY MODULE IN THE PACKAGE WITH AN EFFECT ROW, and it is
// `[io, net, time, async]` — which is `std.http`'s `HttpClient.send`
// row and not a choice made here.  `[async]` because the transport
// parks on the socket, `[time]` because the deadline is read from a
// clock, `[io]` because that is what the connection surface under it
// declares.  An ACME client that used the narrower `?Str` one-shots
// would not see a response header, and an ACME client that cannot read
// `Replay-Nonce` and `Location` cannot register an account, cannot find
// its order's URL, and cannot make a second request.  So the row is
// what it is, and the README records it as a place the plan's row
// wanted to widen.
//
// EVERY REQUEST IS A POST, INCLUDING EVERY READ.  RFC 8555 § 6.3
// replaced GET with POST-as-GET: a signed POST whose payload is zero
// bytes.  A client that sent a GET to an order or an authorization URL
// gets 405 from every production server, and the failure names the
// method rather than the design mistake.  `post_as_get` is the read
// and `post` is the write, and there is no `get` on this page at all.
//
// A `badNonce` IS RETRIED HERE, ONCE, AUTOMATICALLY.  RFC 8555 § 6.5
// requires the retry, servers under load hand the error out routinely,
// and a client that surfaced it fails intermittently in a way that
// looks like the network.  `post` retries with the nonce from the very
// reply that refused it; a second `badNonce` is surfaced, because two
// in a row is a clock or a client that is not following the protocol.
//
// EVERY EXCHANGE ANSWERS THE NEXT NONCE, AND THAT IS WHY THERE IS AN
// `AcmeExchange` RATHER THAN A REPLY.  The nonce is single-use — see
// `acmejws` — so an exchange that answered only the reply would leave
// the caller with nothing to sign the next request with, and a client
// that kept one in a field would reuse it.  Threading it out through
// the answer is what makes a reuse something a reader can see.
//
// NOTHING HERE POLLS ON ITS OWN AND NOTHING HERE SLEEPS.
// `poll_order`, `poll_authorization` and `poll_challenge` each perform
// ONE request and answer what they found; the loop, the backoff and
// the deadline are the caller's, with `acmerenew.poll_backoff_seconds`
// as the schedule.  A library that ran its own loop would own a
// timeout policy for a process it knows nothing about, and would hide
// the one thing an operator watching an issuance wants to see.

use std.bytes
use std.list
use std.time
use acmecsr
use acmejws
use acmemsg
use civil
use jwtalg

// The public directory URL of the free certificate authority most
// callers mean.
pub fn letsencrypt_directory_url() -> Str []
    "https://acme-v02.api.letsencrypt.org/directory"

// The staging directory: real protocol, untrusted certificates, and
// rate limits wide enough to develop against.
//
// Named beside the production one on purpose.  Every rate limit a
// first-time user runs into is one they would not have hit here.
pub fn letsencrypt_staging_directory_url() -> Str []
    "https://acme-staging-v02.api.letsencrypt.org/directory"

// How a client signs, and who it says it is.
//
// The signing function is an argument for the reason `acmejws` gives:
// there is no ECDSA signer on this grid.  A named function, so it
// survives a device build.
pub struct AcmeSigner
    alg: JwtAlg
    // RFC 7638 canonical JWK for the account key.  One copy, used for
    // the protected header and for every thumbprint, so the two cannot
    // disagree.
    jwk_json: Str
    sign: fn(Bytes) -> ?Bytes

// A client session: where the server is, who we are, and the one
// unused nonce we hold.
pub struct AcmeSession
    directory: AcmeDirectory
    signer: AcmeSigner
    // Empty until an account has been registered; the `kid` every
    // request after that is signed with.
    account_url: Str
    timeout_ms: Int
    // A user agent string, which a certificate authority will ask for
    // when something goes wrong at scale.
    user_agent: Str

// One exchange: what the server said, and the nonce for the next
// request.
//
// The nonce is in the answer rather than in a field, because it is
// single-use and a value that is threaded cannot be quietly reused.
pub struct AcmeExchange
    status: Int
    body: Str
    // From the `Location` header — an account's URL, an order's URL.
    location: Str
    // From `Retry-After`, in seconds; 0 when the header was absent.
    retry_after: Int
    // The `Link: <...>;rel="up"` header, which is how a certificate
    // download offers alternate chains.
    link_up: Str
    next_nonce: AcmeNonce
    // Every `Link` header line, as the server wrote it.  `link_up` and
    // `alternate_chains` read from these.
    links: [Str]

// What can go wrong talking to a certificate authority.
pub enum AcmeClientFault
    // The request never reached the server.
    AcmeClientTransportFailed(detail: Str)
    // A reply with no `Replay-Nonce`, which leaves the session with
    // nothing to sign the next request with.  Named separately because
    // it is a server fault and the recovery is different: fetch a fresh
    // nonce rather than retry.
    AcmeClientNoNonce(url: Str)
    // A newAccount or newOrder reply with no `Location` header, so the
    // object has no URL.
    AcmeClientNoLocation(url: Str)
    // The server answered a problem document.
    AcmeClientProblem(problem: AcmeProblem)
    // The server said to slow down: the problem, and the seconds its
    // `Retry-After` header asked for, or 0 when it gave none.
    AcmeClientRateLimited(problem: AcmeProblem, retry_after: Int)
    // A status this package does not expect for the request it made.
    AcmeClientUnexpectedStatus(url: Str, status: Int)
    // A second `badNonce` for the same request.  Once is the protocol;
    // twice is a clock skew or a client bug, and it is surfaced.
    AcmeClientNonceRetryExhausted(url: Str)
    // A message could not be read.
    AcmeClientBadMessage(fault: AcmeMsgFault)
    // A request could not be signed.
    AcmeClientBadSignature(fault: AcmeJwsFault)
    // A request made before the account was registered, which has no
    // `kid` to sign with.
    AcmeClientNoAccount
    // A URL that is not https.  An ACME exchange carries an account
    // identity and a certificate order, so only a loopback address,
    // which a test server uses, may be plain http.
    AcmeClientInsecureUrl(url: Str)

// A signer from an algorithm, a canonical JWK and a signing function.
pub fn signer(alg: JwtAlg, jwk_json: Str, sign: fn(Bytes) -> ?Bytes) -> AcmeSigner []
    AcmeSigner { alg: alg, jwk_json: jwk_json, sign: sign }

// Fetch the directory and open a session.
pub fn session(directory_url: Str,
               s: AcmeSigner) -> Result<AcmeSession, AcmeClientFault> [io, net, time, async]
    let probe = AcmeSession { directory: empty_directory(), signer: s, account_url: "",
                              timeout_ms: 30000, user_agent: DEFAULT_USER_AGENT }
    let reply = send(probe, "GET", directory_url, "", "", "")!
    if reply.status != 200
        return Err(AcmeClientUnexpectedStatus(directory_url, reply.status))
    match acmemsg.parse_directory(bytes.to_str(reply.body), acmemsg.default_limits())
        Err(f)  => Err(AcmeClientBadMessage(f))
        Ok(dir) => Ok(AcmeSession { directory: dir, signer: s, account_url: "",
                                    timeout_ms: probe.timeout_ms, user_agent: probe.user_agent })

// A session with a different request deadline.
pub fn with_timeout(s: AcmeSession, ms: Int) -> AcmeSession []
    AcmeSession { directory: s.directory, signer: s.signer, account_url: s.account_url,
                  timeout_ms: ms, user_agent: s.user_agent }

// A session that identifies itself, which a certificate authority will
// ask for when something goes wrong at scale.
pub fn with_user_agent(s: AcmeSession, ua: Str) -> AcmeSession []
    AcmeSession { directory: s.directory, signer: s.signer, account_url: s.account_url,
                  timeout_ms: s.timeout_ms, user_agent: ua }

// Fetch a fresh nonce.
//
// A HEAD to the newNonce URL, which is the one request in the protocol
// that is not a signed POST.
pub fn fresh_nonce(s: AcmeSession) -> Result<AcmeNonce, AcmeClientFault> [io, net, time, async]
    let target = s.directory.new_nonce
    let reply = send(s, "HEAD", target, "", "", "")!
    let nonce = header_value(reply, "Replay-Nonce")
    if reply.status != 200 and reply.status != 204
        Err(AcmeClientUnexpectedStatus(target, reply.status))
    else if nonce == ""
        Err(AcmeClientNoNonce(target))
    else
        Ok(acmejws.nonce(nonce))

// One signed POST, retrying once on `badNonce`.
//
// The nonce goes in and the next one comes out inside the exchange.
pub fn post(s: AcmeSession, n: AcmeNonce, url: Str, key: AcmeJwsKeyId,
            payload_json: Str) -> Result<AcmeExchange, AcmeClientFault> [io, net, time, async]
    post_with(s, n, url, key, payload_json, "")

// One POST-as-GET: a signed POST with an empty payload, which is how
// every read in this protocol is done.
pub fn post_as_get(s: AcmeSession, n: AcmeNonce,
                   url: Str) -> Result<AcmeExchange, AcmeClientFault> [io, net, time, async]
    post_with(s, n, url, AcmeJwsKid(s.account_url), acmejws.post_as_get_payload(), "")

// Register an account, or find the existing one for this key.
//
// Signed with `jwk` and not `kid`, because there is no account URL yet
// — that is what this request produces, and it arrives in the
// `Location` header.
pub fn new_account(s: AcmeSession, n: AcmeNonce, contact: [Str],
                   terms_agreed: Bool) -> Result<(AcmeSession, AcmeAccount, AcmeNonce), AcmeClientFault> [io, net, time, async]
    let payload = payload_or(acmemsg.write_new_account(contact, terms_agreed, false))!
    let x = post(s, n, s.directory.new_account, AcmeJwsJwk(s.signer.jwk_json), payload)!
    account_from(s, x)

// Find the account for this key WITHOUT creating one.
//
// `onlyReturnExisting`, which answers `accountDoesNotExist` rather than
// registering.  What a program that expects to have an account already
// should use, so a lost key is an error rather than a silent second
// account with no orders in it.
pub fn find_account(s: AcmeSession,
                    n: AcmeNonce) -> Result<(AcmeSession, AcmeAccount, AcmeNonce), AcmeClientFault> [io, net, time, async]
    let payload = payload_or(acmemsg.write_new_account([], false, true))!
    let x = post(s, n, s.directory.new_account, AcmeJwsJwk(s.signer.jwk_json), payload)!
    account_from(s, x)

// Create an order for a set of names.
pub fn new_order(s: AcmeSession, n: AcmeNonce,
                 identifiers: [AcmeIdentifier]) -> Result<(AcmeOrder, AcmeNonce), AcmeClientFault> [io, net, time, async]
    if s.account_url == ""
        return Err(AcmeClientNoAccount)
    let payload = payload_or(acmemsg.write_new_order(identifiers, "", ""))!
    let x = post(s, n, s.directory.new_order, AcmeJwsKid(s.account_url), payload)!
    if x.location == ""
        return Err(AcmeClientNoLocation(s.directory.new_order))
    let order = message_or(acmemsg.parse_order(x.body, x.location, acmemsg.default_limits()))!
    Ok((order, x.next_nonce))

// Read an authorization.
pub fn authorization(s: AcmeSession, n: AcmeNonce,
                     url: Str) -> Result<(AcmeAuthorization, AcmeNonce), AcmeClientFault> [io, net, time, async]
    let x = read_object(s, n, url)!
    let authz = message_or(acmemsg.parse_authorization(x.body, url, acmemsg.default_limits()))!
    Ok((authz, x.next_nonce))

// Tell the server a challenge is ready to be checked.
//
// The payload is `{}` and not an empty one — see
// `acmemsg.write_challenge_ready`.  The caller must have published the
// challenge value BEFORE this call, because the server may check
// immediately.
pub fn challenge_ready(s: AcmeSession, n: AcmeNonce,
                       challenge_url: Str) -> Result<(AcmeChallenge, AcmeNonce), AcmeClientFault> [io, net, time, async]
    if s.account_url == ""
        return Err(AcmeClientNoAccount)
    let x = post(s, n, challenge_url, AcmeJwsKid(s.account_url), acmemsg.write_challenge_ready())!
    let chal = message_or(acmemsg.parse_challenge(x.body, acmemsg.default_limits()))!
    Ok((chal, x.next_nonce))

// Read a challenge once.  The loop is the caller's.
pub fn poll_challenge(s: AcmeSession, n: AcmeNonce,
                      challenge_url: Str) -> Result<(AcmeChallenge, AcmeNonce), AcmeClientFault> [io, net, time, async]
    let x = read_object(s, n, challenge_url)!
    let chal = message_or(acmemsg.parse_challenge(x.body, acmemsg.default_limits()))!
    Ok((chal, x.next_nonce))

// Read an authorization once.  The loop is the caller's.
pub fn poll_authorization(s: AcmeSession, n: AcmeNonce,
                          url: Str) -> Result<(AcmeAuthorization, AcmeNonce), AcmeClientFault> [io, net, time, async]
    authorization(s, n, url)

// Read an order once.  The loop is the caller's.
pub fn poll_order(s: AcmeSession, n: AcmeNonce,
                  url: Str) -> Result<(AcmeOrder, AcmeNonce), AcmeClientFault> [io, net, time, async]
    let x = read_object(s, n, url)!
    let order = message_or(acmemsg.parse_order(x.body, url, acmemsg.default_limits()))!
    Ok((order, x.next_nonce))

// Finalise an order with a certification request.
//
// Check `acmecsr.names_match` first.  A finalise the server refuses
// makes the ORDER invalid, and an invalid order cannot be retried — the
// whole issuance starts again, challenges included.
pub fn finalize(s: AcmeSession, n: AcmeNonce, finalize_url: Str,
                csr_der: Bytes) -> Result<(AcmeOrder, AcmeNonce), AcmeClientFault> [io, net, time, async]
    if s.account_url == ""
        return Err(AcmeClientNoAccount)
    let payload = payload_or(acmemsg.write_finalize(acmecsr.csr_text(csr_der)))!
    let x = post(s, n, finalize_url, AcmeJwsKid(s.account_url), payload)!
    let order_url = if x.location == ""
        finalize_url
    else
        x.location
    let order = message_or(acmemsg.parse_order(x.body, order_url, acmemsg.default_limits()))!
    Ok((order, x.next_nonce))

// Download the issued certificate chain as PEM.
//
// A POST-as-GET like every other read.  The reply's `Link` header with
// `rel="alternate"` offers other chains — a shorter one, or one rooted
// differently — and `download_alternate` is how a caller takes one.
pub fn download_certificate(s: AcmeSession, n: AcmeNonce,
                            certificate_url: Str) -> Result<(Str, AcmeNonce), AcmeClientFault> [io, net, time, async]
    if s.account_url == ""
        return Err(AcmeClientNoAccount)
    let x = post_with(s, n, certificate_url, AcmeJwsKid(s.account_url),
                      acmejws.post_as_get_payload(), "application/pem-certificate-chain")!
    Ok((x.body, x.next_nonce))

// The alternate chain URLs a certificate download offered.
pub fn alternate_chains(x: AcmeExchange) -> [Str] []
    link_targets(x.links, "alternate")

// Revoke a certificate, signed with the account key.
pub fn revoke(s: AcmeSession, n: AcmeNonce, certificate_der: Bytes,
              reason: Int) -> Result<AcmeNonce, AcmeClientFault> [io, net, time, async]
    if s.account_url == ""
        return Err(AcmeClientNoAccount)
    let payload = payload_or(acmemsg.write_revoke(acmecsr.csr_text(certificate_der), reason))!
    let x = post(s, n, s.directory.revoke_cert, AcmeJwsKid(s.account_url), payload)!
    Ok(x.next_nonce)

// Deactivate an authorization, so a later order for the name has to
// prove control again.
//
// What to run when a name stops being yours: a valid authorization is
// cached by the server for weeks, and until it is deactivated the
// account can order a certificate for a name it no longer controls.
pub fn deactivate_authorization(s: AcmeSession, n: AcmeNonce,
                                url: Str) -> Result<(AcmeAuthorization, AcmeNonce), AcmeClientFault> [io, net, time, async]
    if s.account_url == ""
        return Err(AcmeClientNoAccount)
    let x = post(s, n, url, AcmeJwsKid(s.account_url), acmemsg.write_deactivate())!
    let authz = message_or(acmemsg.parse_authorization(x.body, url, acmemsg.default_limits()))!
    Ok((authz, x.next_nonce))

// The wall clock, UTC, for a caller planning a renewal.
//
// The one function in the package that reads a clock for its own sake
// — the `[time]` in every row above is `std.http`'s deadline rather
// than this.
pub fn now_civil() -> CivilDateTime [time]
    let secs = time.now() as Int
    let day = secs / 86400
    let rest = secs % 86400
    civil.datetime(civil.date_from_epoch_day(day),
                   CivilTime { hour: rest / 3600, minute: rest / 60 % 60, second: rest % 60, nano: 0 })

// Whether an exchange carried a problem document rather than an
// object.
pub fn is_problem(x: AcmeExchange) -> Bool []
    x.status >= 400

// The problem an exchange carried.
pub fn problem_of(x: AcmeExchange) -> Result<AcmeProblem, AcmeClientFault> []
    message_or(acmemsg.parse_problem(x.body, acmemsg.default_limits()))

// What went wrong talking to the certificate authority, in one line.
//
// A problem document renders as its `detail`, because that is the
// sentence the server wrote for a person to read, and everything a
// client could add to it is noise.
//
// ```novo ignore
// use acmeclient
//
// fn report(e: AcmeClientFault) -> Str
//     e.message()
// ```
impl Error for AcmeClientFault
    fn message(self) -> Str
        match self
            AcmeClientTransportFailed(d)     => "the request did not reach the server: ${d}"
            AcmeClientNoNonce(u)             => "the reply from ${u} carried no Replay-Nonce header"
            AcmeClientNoLocation(u)          => "the reply from ${u} carried no Location header"
            AcmeClientProblem(p)             => acmemsg.problem_text(p)
            AcmeClientRateLimited(p, wait)   => "${acmemsg.problem_text(p)} (retry after ${wait} seconds)"
            AcmeClientUnexpectedStatus(u, s) => "${u} answered status ${s}, which is not the answer to this request"
            AcmeClientNonceRetryExhausted(u) => "the server refused two nonces in a row for ${u}"
            AcmeClientBadMessage(f)          => "the server's message could not be read: ${f.message()}"
            AcmeClientBadSignature(f)        => "the request could not be signed: ${f.message()}"
            AcmeClientNoAccount              => "no account is registered on this session; call new_account or find_account first"
            AcmeClientInsecureUrl(u)         => "${u} is not an https URL; only a loopback address may be plain http"

// The user agent a session sends until `with_user_agent` replaces it.
const DEFAULT_USER_AGENT = "acme-nv/0.1.0"

// A directory with nothing in it, for the session that fetches the
// real one.
fn empty_directory() -> AcmeDirectory []
    AcmeDirectory { new_nonce: "", new_account: "", new_order: "", revoke_cert: "", key_change: "",
                    terms_of_service: "", website: "", caa_identities: [], external_account_required: false }

// Whether a URL may carry an ACME exchange: https, or plain http to a
// loopback address.
fn url_allowed(url: Str) -> Bool []
    str.starts_with(url, "https://") or str.starts_with(url, "http://127.0.0.1")
        or str.starts_with(url, "http://localhost") or str.starts_with(url, "http://[::1]")

// One HTTP exchange.  The `Content-Type` and the `Accept` are left
// off when they are empty.
fn send(s: AcmeSession, method: Str, url: Str, content_type: Str, accept: Str,
        body: Str) -> Result<HttpReply, AcmeClientFault> [io, net, time, async]
    if not url_allowed(url)
        return Err(AcmeClientInsecureUrl(url))
    var c = HttpClient.new(url).with_timeout(s.timeout_ms).with_redirects(0)
    c = c.with_header("User-Agent", s.user_agent)
    if content_type != ""
        c = c.with_header("Content-Type", content_type)
    if accept != ""
        c = c.with_header("Accept", accept)
    match c.send(method, url, bytes.from_str(body))
        Err(e)    => Err(AcmeClientTransportFailed(http.client.error_text(e)))
        Ok(reply) => Ok(reply)

// The first header of that name, or `""`.
fn header_value(r: HttpReply, name: Str) -> Str []
    http.client.header(r, name) ?? ""

// One signed POST, without the retry.  The Bool says the server
// answered `badNonce`, and the exchange then carries the nonce to
// retry with.
fn post_once(s: AcmeSession, n: AcmeNonce, url: Str, key: AcmeJwsKeyId, payload_json: Str,
             accept: Str) -> Result<(Bool, AcmeExchange), AcmeClientFault> [io, net, time, async]
    let sign = s.signer.sign
    let body = match acmejws.signed_request(sign, s.signer.alg, n, url, key, payload_json)
        Err(e) =>
            return Err(AcmeClientBadSignature(e))
        Ok(b)  => b
    let reply = send(s, "POST", url, "application/jose+json", accept, body)!
    read_reply(url, reply)

// A reply read as an exchange.  A 2xx is one; `badNonce` is one that
// asks for a retry; any other problem is the fault.
fn read_reply(url: Str, r: HttpReply) -> Result<(Bool, AcmeExchange), AcmeClientFault> []
    let nonce = header_value(r, "Replay-Nonce")
    let text = bytes.to_str(r.body)
    let links = link_lines(r)
    let x = AcmeExchange { status: r.status, body: text, location: header_value(r, "Location"),
                           retry_after: str.to_int(header_value(r, "Retry-After")) ?? 0,
                           link_up: first_target(links, "up"),
                           next_nonce: acmejws.nonce(nonce), links: links }
    if r.status >= 200 and r.status < 300
        if nonce == ""
            Err(AcmeClientNoNonce(url))
        else
            Ok((false, x))
    else
        match acmemsg.parse_problem(text, acmemsg.default_limits())
            Err(_) => Err(AcmeClientUnexpectedStatus(url, r.status))
            Ok(p)  =>
                if p.kind == ""
                    Err(AcmeClientUnexpectedStatus(url, r.status))
                else if acmemsg.problem_is_bad_nonce(p)
                    if nonce == ""
                        Err(AcmeClientNoNonce(url))
                    else
                        Ok((true, x))
                else if acmemsg.problem_is_rate_limit(p)
                    Err(AcmeClientRateLimited(p, x.retry_after))
                else
                    Err(AcmeClientProblem(p))

// The signed POST with a retry on `badNonce`, taking an `Accept`.
fn post_with(s: AcmeSession, n: AcmeNonce, url: Str, key: AcmeJwsKeyId, payload_json: Str,
             accept: Str) -> Result<AcmeExchange, AcmeClientFault> [io, net, time, async]
    check_key(s, url, key)!
    let first = post_once(s, n, url, key, payload_json, accept)!
    if not first.0
        return Ok(first.1)
    let second = post_once(s, first.1.next_nonce, url, key, payload_json, accept)!
    if second.0
        Err(AcmeClientNonceRetryExhausted(url))
    else
        Ok(second.1)

// RFC 8555 section 6.2: newAccount is signed with the key itself and
// every account request with the account URL; only a revocation may
// be signed with the certificate's own key.
fn check_key(s: AcmeSession, url: Str, key: AcmeJwsKeyId) -> Result<Bool, AcmeClientFault> []
    match key
        AcmeJwsJwk(_) =>
            if url == s.directory.new_account or url == s.directory.revoke_cert
                Ok(true)
            else
                Err(AcmeClientBadSignature(AcmeJwsWrongKeyId(url, "a kid: the account URL")))
        AcmeJwsKid(_) =>
            if url == s.directory.new_account
                Err(AcmeClientBadSignature(AcmeJwsWrongKeyId(url, "a jwk: the account key itself")))
            else
                Ok(true)

// A read: a POST-as-GET.
fn read_object(s: AcmeSession, n: AcmeNonce,
               url: Str) -> Result<AcmeExchange, AcmeClientFault> [io, net, time, async]
    if s.account_url == ""
        Err(AcmeClientNoAccount)
    else
        post_as_get(s, n, url)

// A newAccount reply as the session, the account and the next nonce.
fn account_from(s: AcmeSession,
                x: AcmeExchange) -> Result<(AcmeSession, AcmeAccount, AcmeNonce), AcmeClientFault> []
    if x.location == ""
        return Err(AcmeClientNoLocation(s.directory.new_account))
    let account = message_or(acmemsg.parse_account(x.body, x.location, acmemsg.default_limits()))!
    let next = AcmeSession { directory: s.directory, signer: s.signer, account_url: x.location,
                             timeout_ms: s.timeout_ms, user_agent: s.user_agent }
    Ok((next, account, x.next_nonce))

fn payload_or(r: Result<Str, AcmeMsgFault>) -> Result<Str, AcmeClientFault> []
    match r
        Ok(p)  => Ok(p)
        Err(f) => Err(AcmeClientBadMessage(f))

fn message_or<T>(r: Result<T, AcmeMsgFault>) -> Result<T, AcmeClientFault> []
    match r
        Ok(v)  => Ok(v)
        Err(f) => Err(AcmeClientBadMessage(f))

// Every `Link` header line of a reply.
fn link_lines(r: HttpReply) -> [Str] []
    var out: [Str] = []
    for line in r.headers
        let colon = str.index(line, ":") ?? -1
        if colon > 0 and str.lower(str.trim(str.slice(line, 0, colon))) == "link"
            list.push(out, str.trim(str.slice(line, colon + 1, str.len(line))))
    out

// The targets of the links with this `rel`.  A header line may hold
// several links separated by commas.
fn link_targets(links: [Str], rel: Str) -> [Str] []
    var out: [Str] = []
    for line in links
        for part in str.split(line, ",")
            if str.contains(part, "rel=\"" + rel + "\"") or str.contains(part, "rel=" + rel)
                let open = str.index(part, "<") ?? -1
                let close = str.index_from(part, ">", open + 1) ?? -1
                if open >= 0 and close > open
                    list.push(out, str.slice(part, open + 1, close))
    out

fn first_target(links: [Str], rel: Str) -> Str []
    let all = link_targets(links, rel)
    if list.len(all) == 0
        ""
    else
        all[0]
